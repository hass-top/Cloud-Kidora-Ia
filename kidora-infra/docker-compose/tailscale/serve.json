{
	"TCP": {
		"443": { "HTTPS": true },
		"8443": { "HTTPS": true }
	},
	"Web": {
		"${TS_CERT_DOMAIN}:443": {
			"Handlers": {
				"/": { "Proxy": "http://127.0.0.1:80" }
			}
		},
		"${TS_CERT_DOMAIN}:8443": {
			"Handlers": {
				"/": { "Proxy": "http://minio:9001" }
			}
		}
	},
	"AllowFunnel": {
		"${TS_CERT_DOMAIN}:443": false,
		"${TS_CERT_DOMAIN}:8443": false
	}
}
