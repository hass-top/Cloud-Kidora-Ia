# =============================================================================
#  Kidora - LOCAL DEV environment (EXAMPLE)
# =============================================================================
#  Copy to `.env` (gitignored) and fill in the values marked REQUIRED:
#      cp docker-compose/.env.example docker-compose/.env
#
#  Compose reads `.env` automatically because it sits next to
#  docker-compose.dev.yml. Those REQUIRED values are written as `:?` in the
#  compose file, so Compose aborts with a clear message when one is missing
#  rather than silently falling back to a weak default.
# =============================================================================

# --- Application images (GitHub Container Registry) --------------------------
# All four are PRIVATE. Log in first:
#   echo "$GITHUB_PAT" | docker login ghcr.io -u <github-user> --password-stdin
# The PAT needs the `read:packages` scope.
FRONTEND_IMAGE=ghcr.io/hass-top/kidora-frontend:latest
BACKEND_IMAGE=ghcr.io/hass-top/kidora-backend:latest
# NB: the AI service publishes as `kidora-ia-center`, not `kidora-ai-backend`.
AI_BACKEND_IMAGE=ghcr.io/hass-top/kidora-ia-center:latest
BACKOFFICE_IMAGE=ghcr.io/hass-top/kidora-backoffice:latest

# Pin an immutable build instead of :latest for reproducible local testing:
#   BACKEND_IMAGE=ghcr.io/hass-top/kidora-backend:1a2b3c4

# --- MongoDB -----------------------------------------------------------------
# REQUIRED. This is what the backend actually connects to; a mongodb+srv://
# Atlas URI works as well as a plain mongodb:// one.
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net
MONGO_INITDB_ROOT_USERNAME=admin
# REQUIRED - the root password of the bundled `mongo:8` container. The compose
# file reads it as MONGODB_PASSWORD and hands it to the container as
# MONGO_INITDB_ROOT_PASSWORD, so setting MONGO_INITDB_ROOT_PASSWORD= here would
# do nothing.
MONGODB_PASSWORD=
MONGO_INITDB_DATABASE=kidora
MONGO_PORT=27017

# --- MinIO -------------------------------------------------------------------
MINIO_ROOT_USER=admin
# REQUIRED - a long random string. Do NOT reuse the MongoDB password.
MINIO_ROOT_PASSWORD=
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_BUCKET=kidora
# Optional. The Console's post-login redirect, for when it is reached over
# Tailscale on https://kidora-backoffice.<tailnet>.ts.net:8443 (see the
# `tailscale` service and ./tailscale/serve.json). Leave it unset for plain
# local use on http://localhost:9001.
# MINIO_BROWSER_REDIRECT_URL=https://kidora-backoffice.<tailnet>.ts.net:8443

# --- Backend -----------------------------------------------------------------
# REQUIRED. Used to sign auth tokens; it must be identical across restarts or
# everyone's session is invalidated.
APP_SECRET_KEY=
APP_SERVER_URL=http://localhost:8086
APP_BACKEND_PORT=8086
APP_JWT_EXPIRATION_TIME=86400000

# --- Frontend / AI -----------------------------------------------------------
# Host port the SPA is published on. The image serves it on 80 internally.
FRONTEND_PORT=5173
# Host port the dev `nginx` reverse proxy publishes. The commented HTTPS_PORT
# only becomes meaningful once that service gets a TLS listener and certs.
HTTP_PORT=80
# HTTPS_PORT=443
AI_PORT=8000
# FastAPI application title used by the AI service.
APP_NAME=Generateur de Rapports Educatifs IA
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
# Must include the FRONTEND_PORT origin or the browser will be CORS-blocked.
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:8080

# --- AI provider keys -------------------------------------------------------
# The AI service starts without these; the features that need them fail until
# they are filled in. These are DEV keys - never reuse production values.
GROQ_API_KEY=
GROQ_MODEL_NAME=llama-3.3-70b-versatile
GROQ_VISION_MODEL=llama-3.2-90b-vision-preview
BFL_API_KEY=
POLLINATIONS_API_KEY=
IMAGE_PROVIDER=gemini
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
LLM_MEMORY_WINDOW=10

# --- Tailscale ---------------------------------------------------------------
# REQUIRED for the backoffice: the `tailscale` service consumes this key and
# exits without it. Create one in the admin console (Settings -> Keys). The
# tailnet's node name comes from the service's `hostname:` (kidora-backoffice),
# so the private URLs are https://kidora-backoffice.<tailnet>.ts.net and, for
# the MinIO Console, https://kidora-backoffice.<tailnet>.ts.net:8443.
#     docker exec kidora-tailscale tailscale status
TS_AUTHKEY=
