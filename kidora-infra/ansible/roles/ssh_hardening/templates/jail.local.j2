# Fail2Ban configuration for SSH - Managed by Ansible
# This file is managed by Ansible; manual changes will be overwritten.

[DEFAULT]
# Ignore IPs in this list (whitelist)
ignoreip = 127.0.0.1/8 ::1

# Number of failures before a host gets banned
maxretry = 5

# Ban time in seconds (1 hour)
bantime = 3600

# Find time in seconds (10 minutes) - the window for counting failures
findtime = 600

# Use systemd journal if available, otherwise use log files
backend = systemd

# Email notification settings (disabled by default)
destemail = root@localhost
sendername = Fail2Ban
mta = sendmail
action = %(action_)s

[sshd]
enabled = true
port = {{ ssh_port | default(22) }}
filter = sshd
logpath = /var/log/auth.log
maxretry = {{ ssh_max_auth_tries | default(3) }}
bantime = 3600
findtime = 600