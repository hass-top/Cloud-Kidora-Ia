# =============================================================================
#  Application stack — generated by Ansible, DO NOT EDIT BY HAND
# =============================================================================
#  Deployed by roles/app_stack onto the kidora_app host.
#
#  Cross-host note: the dev stack (docker-compose/docker-compose.dev.yml) keeps
#  almost everything internal and reaches it over one nginx. That no longer
#  works once nginx lives on its own server, so each service here publishes the
#  port the edge nginx needs. UFW is what keeps them private — see
#  inventories/staging/group_vars/app.yml.
#
#  MongoDB is the deliberate exception: it binds 127.0.0.1 and is never
#  published to the network.
# =============================================================================
name: kidora-app

services:
  # ===========================================================================
  #  MongoDB
  # ===========================================================================
  mongodb:
    image: mongo:8
    container_name: kidora-mongodb
    restart: unless-stopped
    command: ["--bind_ip_all"]
    environment:
      MONGO_INITDB_ROOT_USERNAME: "{{ mongodb_root_username }}"
      MONGO_INITDB_ROOT_PASSWORD: "${MONGO_ROOT_PASSWORD}"
      # Only meaningful on a first, empty start — it sets the initdb database.
      MONGO_INITDB_DATABASE: "{{ mongodb_database }}"
    volumes:
      - mongodb_data:/data/db
      # Runs once, on the first start of an empty /data/db. Creates the
      # least-privilege application user so the backend never runs as root.
      - ./mongo/init-app-user.js:/docker-entrypoint-initdb.d/10-init-app-user.js:ro
    ports:
      # Loopback only. Reach it with: ssh -L 27017:127.0.0.1:27017 root@app
      - "127.0.0.1:{{ mongodb_port }}:27017"
    healthcheck:
      test: ["CMD", "mongosh", "--quiet", "--eval", "db.adminCommand('ping').ok"]
      interval: 10s
      timeout: 5s
      retries: 12
      start_period: 30s
    networks: [app_net]
    logging: &default_logging
      driver: json-file
      options: { max-size: "10m", max-file: "3" }

  # ===========================================================================
  #  MongoDB exporter
  # ===========================================================================
  # Runs HERE, not on the monitoring host: it authenticates against MongoDB over
  # the Compose network, which the monitoring host cannot reach. Prometheus
  # scrapes it from outside on 9216.
  mongodb-exporter:
    image: {{ monitoring_images.mongo_exporter }}
    container_name: kidora-mongodb-exporter
    restart: unless-stopped
    command:
      - --mongodb.uri=mongodb://{{ mongodb_username }}:{{ vault_mongodb_app_password | urlencode }}@mongodb:27017/?authSource={{ mongodb_database }}
      - --collect-all
      - --compatible-mode
    depends_on:
      mongodb:
        condition: service_healthy
    ports:
      - "0.0.0.0:{{ mongo_exporter_port }}:9216"
    networks: [app_net]
    logging: *default_logging

  # ===========================================================================
  #  MinIO
  # ===========================================================================
  minio:
    image: quay.io/minio/minio:latest
    container_name: kidora-minio
    restart: unless-stopped
    command: ["server", "/data", "--console-address", ":9001"]
    environment:
      MINIO_ROOT_USER: "{{ minio_root_user }}"
      MINIO_ROOT_PASSWORD: "${MINIO_ROOT_PASSWORD}"
    volumes:
      - minio_data:/data
    ports:
      - "0.0.0.0:{{ minio_port }}:9000"
      - "0.0.0.0:{{ minio_console_port }}:9001"
    healthcheck:
      test: ["CMD", "mc", "ready", "local"]
      interval: 15s
      timeout: 5s
      retries: 10
      start_period: 20s
    networks: [app_net]
    logging: *default_logging

  # ===========================================================================
  #  Backend (Spring Boot)
  # ===========================================================================
  backend:
    image: {{ app_images.backend }}
    pull_policy: missing
    container_name: kidora-backend
    restart: unless-stopped
    environment:
      # `mongodb` and `minio` are Compose service names and resolve on app_net.
      SPRING_DATA_MONGODB_URI: "${MONGODB_URI}"
      SPRING_DATA_MONGODB_DATABASE: "{{ mongodb_database }}"
      MINIO_URL: "http://minio:{{ minio_port }}"
      MINIO_ROOT_USER: "{{ minio_root_user }}"
      MINIO_ROOT_PASSWORD: "${MINIO_ROOT_PASSWORD}"
      MINIO_BUCKET: "{{ minio_bucket }}"
      APP_SERVER_URL: "{{ app_server_url }}"
      APP_SECRET_KEY: "${APP_SECRET_KEY}"
      APP_JWT_EXPIRATION_TIME: "${APP_JWT_EXPIRATION_TIME}"
    depends_on:
      mongodb:
        condition: service_healthy
      minio:
        condition: service_healthy
    volumes:
      - backend_uploads:/app/uploads
    ports:
      - "0.0.0.0:{{ backend_port }}:8086"
    networks: [app_net]
    deploy:
      resources:
        limits:
          memory: {{ backend_memory_limit }}
    logging: *default_logging

  # ===========================================================================
  #  AI service
  # ===========================================================================
  ai-backend:
    image: {{ app_images.ai_backend }}
    pull_policy: missing
    container_name: kidora-ai-backend
    restart: unless-stopped
    environment:
      GROQ_API_KEY: "${GROQ_API_KEY}"
      GROQ_MODEL_NAME: "{{ groq_model_name }}"
      GROQ_VISION_MODEL: "{{ groq_vision_model }}"
      LLM_TEMPERATURE: "{{ llm_temperature }}"
      LLM_MAX_TOKENS: "{{ llm_max_tokens }}"
      LLM_MEMORY_WINDOW: "{{ llm_memory_window }}"
      APP_NAME: "{{ ai_app_name }}"
      ENVIRONMENT: "{{ environment }}"
      DEBUG: "false"
      API_HOST: 0.0.0.0
      API_PORT: 8000
      ALLOWED_ORIGINS: "{{ allowed_origins }}"
      LOG_LEVEL: "{{ log_level }}"
      BFL_API_KEY: "${BFL_API_KEY}"
      IMAGE_PROVIDER: "{{ image_provider }}"
      POLLINATIONS_API_KEY: "${POLLINATIONS_API_KEY}"
      # Service name, not an IP: the backend is its sibling on app_net.
      SPRING_BOOT_BASE_URL: "http://backend:{{ backend_port }}"
    depends_on:
      backend:
        condition: service_started
    volumes:
      - ai_uploads:/app/uploads
    ports:
      - "0.0.0.0:{{ ai_port }}:8000"
    networks: [app_net]
    deploy:
      resources:
        limits:
          memory: {{ ai_memory_limit }}
    logging: *default_logging

  # ===========================================================================
  #  Frontend
  # ===========================================================================
  frontend:
    image: {{ app_images.frontend }}
    pull_policy: missing
    container_name: kidora-frontend
    restart: unless-stopped
    depends_on:
      backend:
        condition: service_started
    ports:
      - "0.0.0.0:{{ frontend_port }}:80"
    networks: [app_net]
    logging: *default_logging

  # ===========================================================================
  #  Backoffice
  # ===========================================================================
  # SvelteKit compiled to static and served by the image's own nginx on 80.
  # It cannot share host port 80 with the frontend, hence 8080. The edge nginx
  # only routes `backoffice.<domain>` here, and only over Tailscale.
  backoffice:
    image: {{ app_images.backoffice }}
    pull_policy: missing
    container_name: kidora-backoffice
    restart: unless-stopped
    depends_on:
      backend:
        condition: service_started
    ports:
      - "0.0.0.0:{{ backoffice_port }}:80"
    networks: [app_net]
    logging: *default_logging

  # ===========================================================================
  #  Exporters for THIS host
  # ===========================================================================
  # Bound to 0.0.0.0 because the Prometheus on the monitoring host scrapes them
  # remotely; UFW permits only the monitoring IP.
  node-exporter:
    image: {{ monitoring_images.node_exporter }}
    container_name: kidora-node-exporter
    restart: unless-stopped
    command:
      - --path.rootfs=/host
      - --collector.filesystem.mount-points-exclude=^/(sys|proc|dev|host|etc)($$|/)
    volumes:
      - /:/host:ro,rslave
    pid: host
    ports:
      - "0.0.0.0:{{ node_exporter_port }}:9100"
    networks: [app_net]
    logging: *default_logging

  cadvisor:
    image: {{ monitoring_images.cadvisor }}
    container_name: kidora-cadvisor
    restart: unless-stopped
    privileged: true
    command: ["--housekeeping_interval=15s", "--docker_only=true"]
    volumes:
      - /:/rootfs:ro
      - /var/run:/var/run:ro
      - /sys:/sys:ro
      - /var/lib/docker/:/var/lib/docker:ro
      - /dev/disk/:/dev/disk:ro
    ports:
      - "0.0.0.0:{{ cadvisor_port }}:8080"
    networks: [app_net]
    logging: *default_logging

networks:
  app_net:
    driver: bridge
    name: kidora_app_net

volumes:
  mongodb_data:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: "{{ deploy_root }}/data/mongodb"
  minio_data:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: "{{ deploy_root }}/data/minio"
  backend_uploads:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: "{{ deploy_root }}/data/backend-uploads"
  ai_uploads:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: "{{ deploy_root }}/data/ai-uploads"
