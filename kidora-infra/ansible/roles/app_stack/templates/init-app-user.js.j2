// =============================================================================
//  init-app-user.js — generated by Ansible. Runs ONCE.
// =============================================================================
//  Mounted into /docker-entrypoint-initdb.d, so the official mongo image
//  executes it during initialisation — that is, only when /data/db is empty.
//  Changing the credentials below after the first start has no effect; use the
//  `mongodb-init` playbook task or a mongosh session instead.
//
//  The application user is deliberately NOT root: the backend gets readWrite on
//  a single database and nothing else, so a compromise of the API cannot drop
//  the database or read the admin database.
// =============================================================================

const appUser = {{ mongodb_username | to_json }};
const appPassword = {{ vault_mongodb_app_password | to_json }};
const appDatabase = {{ mongodb_database | to_json }};

const target = db.getSiblingDB(appDatabase);

// Idempotent inside the file as well: the image may run this more than once
// during a retry, and createUser throws on an existing user.
const existing = target.getUser(appUser);

if (existing) {
  print(`[init-app-user] user '${appUser}' already exists in '${appDatabase}', leaving it alone`);
} else {
  target.createUser({
    user: appUser,
    pwd: appPassword,
    roles: [
      { role: "readWrite", db: appDatabase },
    ],
  });
  print(`[init-app-user] created user '${appUser}' with readWrite on '${appDatabase}'`);
}
