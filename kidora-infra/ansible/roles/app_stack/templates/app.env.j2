# =============================================================================
#  Generated by Ansible from the vault. DO NOT EDIT, DO NOT COMMIT.
# =============================================================================
#  Docker Compose interpolates ${VAR} from this file. It is written 0600 and
#  owned by the deploy user; anyone who can read it can read every secret in
#  the stack.
# =============================================================================

# --- MongoDB ------------------------------------------------------------------
MONGO_ROOT_PASSWORD={{ vault_mongodb_root_password }}
# Points at the Compose service name, not an IP: the backend and MongoDB are
# siblings on app_net. The password is URL-encoded because it is embedded in
# a URI, and an unencoded '@' or '/' in it changes how the driver parses the
# whole string.
MONGODB_URI=mongodb://{{ mongodb_username }}:{{ vault_mongodb_app_password | urlencode }}@mongodb:27017/{{ mongodb_database }}?authSource={{ mongodb_database }}

# --- MinIO --------------------------------------------------------------------
MINIO_ROOT_PASSWORD={{ vault_minio_root_password }}

# --- Backend ------------------------------------------------------------------
APP_SECRET_KEY={{ vault_app_secret_key }}
APP_JWT_EXPIRATION_TIME=86400000

# --- AI service ---------------------------------------------------------------
# Optional: the service starts without them, but the features that need them
# fail at call time. Leave blank rather than inventing a placeholder value.
GROQ_API_KEY={{ vault_groq_api_key | default('') }}
BFL_API_KEY={{ vault_bfl_api_key | default('') }}
POLLINATIONS_API_KEY={{ vault_pollinations_api_key | default('') }}
