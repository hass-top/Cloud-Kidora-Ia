# =============================================================================
#  prometheus.yml — generated by Ansible, DO NOT EDIT BY HAND
# =============================================================================
#  Edits are overwritten on the next run of 20-monitoring.yml. Change
#  roles/prometheus_stack/templates/prometheus.yml.j2 instead.
# =============================================================================
global:
  scrape_interval: {{ prometheus_scrape_interval }}
  scrape_timeout: {{ prometheus_scrape_timeout }}
  evaluation_interval: {{ prometheus_scrape_interval }}
  external_labels:
    cluster: kidora-{{ environment }}
    role: monitoring

rule_files:
  - /etc/prometheus/rules/*.yml

alerting:
  alertmanagers:
    - static_configs:
        - targets:
            - 127.0.0.1:{{ alertmanager_port }}

scrape_configs:
  # --- Prometheus itself -----------------------------------------------------
  - job_name: prometheus
    static_configs:
      - targets: ["127.0.0.1:{{ prometheus_port }}"]
        labels:
          instance: kidora-monitoring

  # --- Alertmanager ----------------------------------------------------------
  - job_name: alertmanager
    static_configs:
      - targets: ["127.0.0.1:{{ alertmanager_port }}"]

  # --- Grafana ---------------------------------------------------------------
  - job_name: grafana
    metrics_path: /metrics
    static_configs:
      - targets: ["127.0.0.1:{{ grafana_port }}"]

  # --- Node metrics ----------------------------------------------------------
  # This host's own exporter binds loopback; the other two bind 0.0.0.0 and are
  # reachable only because UFW permits the monitoring IP (see group_vars).
  - job_name: node
    static_configs:
      - targets: ["127.0.0.1:{{ node_exporter_port }}"]
        labels: { instance: kidora-monitoring, tier: control }
      - targets: ["{{ kidora_app_ip }}:{{ node_exporter_port }}"]
        labels: { instance: kidora-app, tier: app }
      - targets: ["{{ kidora_edge_ip }}:{{ node_exporter_port }}"]
        labels: { instance: kidora-edge, tier: edge }

  # --- Container metrics (cAdvisor) ------------------------------------------
  - job_name: cadvisor
    static_configs:
      - targets: ["127.0.0.1:{{ cadvisor_port }}"]
        labels: { instance: kidora-monitoring, tier: control }
      - targets: ["{{ kidora_app_ip }}:{{ cadvisor_port }}"]
        labels: { instance: kidora-app, tier: app }
      - targets: ["{{ kidora_edge_ip }}:{{ cadvisor_port }}"]
        labels: { instance: kidora-edge, tier: edge }

  # --- MongoDB ---------------------------------------------------------------
  # percona/mongodb_exporter runs on the app host (it needs to reach MongoDB
  # over the Compose network) and is scraped from here.
  - job_name: mongodb
    static_configs:
      - targets: ["{{ kidora_app_ip }}:{{ mongo_exporter_port }}"]
        labels: { instance: kidora-app }
