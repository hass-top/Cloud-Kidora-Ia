# =============================================================================
#  Grafana datasource provisioning — generated by Ansible
# =============================================================================
#  Lives in the Grafana "datasources" provisioning folder, so Grafana creates
#  or updates the Prometheus datasource on every boot. No clicking in the UI,
#  and the configuration survives a container rebuild.
# =============================================================================
apiVersion: 1

datasources:
  - name: {{ grafana_datasource_name }}
    type: prometheus
    access: proxy
    # `proxy` means Grafana queries Prometheus server-side; the browser never
    # talks to :9090 directly, so Prometheus can stay unexposed to the client.
    url: http://prometheus:{{ prometheus_port }}
    isDefault: true
    editable: false
    jsonData:
      # Matches prometheus_scrape_interval so the Grafana min-step never asks
      # for a resolution the TSDB does not have.
      timeInterval: "{{ prometheus_scrape_interval }}"
      httpMethod: POST
