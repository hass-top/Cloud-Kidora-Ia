# =============================================================================
#  Monitoring stack — generated by Ansible, DO NOT EDIT BY HAND
# =============================================================================
#  Deployed by roles/prometheus_stack onto the kidora_monitoring host.
#  Only Prometheus, Alertmanager and Grafana run here; the exporters that
#  measure the other two servers run on those servers (see roles/app_stack).
# =============================================================================
name: kidora-monitoring

services:
  prometheus:
    image: {{ monitoring_images.prometheus }}
    container_name: kidora-prometheus
    restart: unless-stopped
    user: "65534:65534"
    command:
      - --config.file=/etc/prometheus/prometheus.yml
      - --storage.tsdb.path=/prometheus
      - --storage.tsdb.retention.time={{ prometheus_retention }}
      - --storage.tsdb.retention.size={{ prometheus_retention_size }}
      - --web.enable-lifecycle
      - --web.enable-admin-api
    volumes:
      - ./prometheus/prometheus.yml:/etc/prometheus/prometheus.yml:ro
      - ./alertmanager/alertmanager.yml:/etc/alertmanager/alertmanager.yml:ro
      - ./prometheus/rules:/etc/prometheus/rules:ro
      - prometheus_data:/prometheus
    ports:
      # Published so the edge nginx can proxy it. UFW restricts the source to
      # the edge IP — see inventories/staging/group_vars/monitoring.yml.
      - "{{ prometheus_bind_address }}:{{ prometheus_port }}:9090"
    healthcheck:
      test: ["CMD", "wget", "--spider", "-q", "http://localhost:9090/-/healthy"]
      interval: 30s
      timeout: 5s
      retries: 5
      start_period: 30s
    networks: [monitoring_net]
    logging: &default_logging
      driver: json-file
      options: { max-size: "10m", max-file: "3" }

  alertmanager:
    image: {{ monitoring_images.alertmanager }}
    container_name: kidora-alertmanager
    restart: unless-stopped
    user: "65534:65534"
    command:
      - --config.file=/etc/alertmanager/alertmanager.yml
      - --storage.path=/alertmanager
      - --data.retention={{ alertmanager_retention }}
    volumes:
      - ./alertmanager/alertmanager.yml:/etc/alertmanager/alertmanager.yml:ro
      - alertmanager_data:/alertmanager
    ports:
      - "{{ prometheus_bind_address }}:{{ alertmanager_port }}:9093"
    networks: [monitoring_net]
    logging: *default_logging

  grafana:
    image: {{ monitoring_images.grafana }}
    container_name: kidora-grafana
    restart: unless-stopped
    user: "472:472"
    environment:
      # Read the password from a 0600 file rather than the environment: `docker
      # inspect` exposes env vars to anyone in the docker group, and a file
      # mounted in is far less of a secret-in-plain-sight.
      GF_SECURITY_ADMIN_USER__FILE: /run/secrets/admin_user
      GF_SECURITY_ADMIN_PASSWORD__FILE: /run/secrets/admin_password
      GF_SERVER_ROOT_URL: "{{ grafana_root_url }}"
      # Cookies must be marked Secure so they are not sent over the port-80
      # redirect, and SameSite so the app and Grafana do not clash.
      GF_SECURITY_COOKIE_SECURE: "true"
      GF_SECURITY_COOKIE_SAMESITE: "lax"
      GF_USERS_ALLOW_SIGN_UP: "false"
      GF_ANALYTICS_REPORTING_ENABLED: "false"
      GF_ANALYTICS_CHECK_FOR_UPDATES: "false"
      GF_INSTALL_PLUGINS: ""
    volumes:
      - grafana_data:/var/lib/grafana
      - ./grafana/provisioning:/etc/grafana/provisioning:ro
    secrets:
      - admin_user
      - admin_password
    ports:
      - "{{ grafana_bind_address }}:{{ grafana_port }}:3000"
    depends_on:
      prometheus:
        condition: service_started
    networks: [monitoring_net]
    logging: *default_logging

  # --- Exporters for THIS host -------------------------------------------------
  # Both bind loopback: nothing off-box needs them, and Prometheus scrapes
  # them over 127.0.0.1.
  node-exporter:
    image: {{ monitoring_images.node_exporter }}
    container_name: kidora-node-exporter
    restart: unless-stopped
    command:
      - --path.rootfs=/host
      - --collector.filesystem.mount-points-exclude=^/(sys|proc|dev|host|etc)($$|/)
    volumes:
      - /:/host:ro,rslave
    pid: host
    ports:
      - "127.0.0.1:{{ node_exporter_port }}:9100"
    networks: [monitoring_net]
    logging: *default_logging

  cadvisor:
    image: {{ monitoring_images.cadvisor }}
    container_name: kidora-cadvisor
    restart: unless-stopped
    privileged: true
    command:
      - --housekeeping_interval=15s
      - --docker_only=true
    volumes:
      - /:/rootfs:ro
      - /var/run:/var/run:ro
      - /sys:/sys:ro
      - /var/lib/docker/:/var/lib/docker:ro
      - /dev/disk/:/dev/disk:ro
    ports:
      - "127.0.0.1:{{ cadvisor_port }}:8080"
    networks: [monitoring_net]
    logging: *default_logging

secrets:
  admin_user:
    file: ./secrets/grafana_admin_user
  admin_password:
    file: ./secrets/grafana_admin_password

networks:
  monitoring_net:
    driver: bridge
    name: kidora_monitoring_net

volumes:
  prometheus_data:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: "{{ deploy_root }}/data/prometheus"
  alertmanager_data:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: "{{ deploy_root }}/data/alertmanager"
  grafana_data:
    driver: local
    driver_opts:
      type: none
      o: bind
      device: "{{ deploy_root }}/data/grafana"
