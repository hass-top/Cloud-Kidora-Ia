# =============================================================================
#  Recording and alerting rules — generated by Ansible
# =============================================================================
groups:
  - name: kidora.recording
    interval: {{ prometheus_scrape_interval }}
    rules:
      # Collapse the per-CPU/per-mode series into the two numbers an alert
      # actually needs. Without these the node-exporter dashboard has to do a
      # rate() in every panel, which is slow and easy to get wrong.
      - record: node:cpu_utilisation:rate5m
        expr: 1 - avg by (instance) (rate(node_cpu_seconds_total{mode="idle"}[5m]))

      - record: node:memory_utilisation:ratio
        expr: 1 - (node_memory_MemAvailable_bytes / node_memory_MemTotal_bytes)

      - record: node:filesystem_utilisation:ratio
        expr: |
          1 - (node_filesystem_avail_bytes{fstype!~"tmpfs|overlay|squashfs"}
               / node_filesystem_size_bytes{fstype!~"tmpfs|overlay|squashfs"})

      - record: instance:container_cpu_usage:rate5m
        expr: |
          sum by (instance, name)
            (rate(container_cpu_usage_seconds_total{name!=""}[5m]))

  - name: kidora.alerts
    rules:
      # --- Host ----------------------------------------------------------------
      - alert: HostDown
        expr: up{job="node"} == 0
        for: 3m
        labels:
          severity: critical
        annotations:
          summary: "{{ '{{ $labels.instance }}' }} is not reporting metrics"
          description: "Prometheus has been unable to scrape node-exporter for 3 minutes."

      - alert: HostHighCpu
        expr: node:cpu_utilisation:rate5m > 0.85
        for: 15m
        labels:
          severity: warning
        annotations:
          summary: "{{ '{{ $labels.instance }}' }} CPU above 85% for 15m"
          description: "Sustained load. Check the container using the CPU on the Grafana dashboard."

      - alert: HostHighMemory
        expr: node:memory_utilisation:ratio > 0.90
        for: 10m
        labels:
          severity: warning
        annotations:
          summary: "{{ '{{ $labels.instance }}' }} memory above 90%"
          description: "Sustained memory pressure; the OOM killer may be about to intervene."

      - alert: HostDiskAlmostFull
        expr: node:filesystem_utilisation:ratio > 0.85
        for: 15m
        labels:
          severity: warning
        annotations:
          summary: "{{ '{{ $labels.instance }}' }} {{ '{{ $labels.mountpoint }}' }} is {{ '{{ $value | humanizePercentage }}' }} full"
          description: "Free space under 15%."

      - alert: HostDiskWillFillIn24h
        # Only fires when the filesystem is both fairly full AND still growing
        # quickly — a nearly-static 85% disk is a warning, not a page.
        expr: |
          predict_linear(node_filesystem_avail_bytes{fstype!~"tmpfs|overlay|squashfs"}[6h], 24 * 3600) < 0
          and node:filesystem_utilisation:ratio > 0.70
        for: 30m
        labels:
          severity: critical
        annotations:
          summary: "{{ '{{ $labels.instance }}' }} {{ '{{ $labels.mountpoint }}' }} will be full within 24h"
          description: "At the current rate the filesystem fills before the next maintenance window."

      # --- Containers ----------------------------------------------------------
      - alert: ContainerRestartLoop
        expr: |
          increase(kube_pod_container_status_restarts_total[15m]) > 3
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "Container {{ '{{ $labels.name }}' }} on {{ '{{ $labels.instance }}' }} is restarting"
          description: "More than 3 restarts in 15 minutes."

      # --- MongoDB -------------------------------------------------------------
      - alert: MongoDown
        expr: up{job="mongodb"} == 0
        for: 5m
        labels:
          severity: critical
        annotations:
          summary: "MongoDB exporter is not answering"
          description: "Prometheus cannot reach the MongoDB exporter on the app server."

      - alert: MongoReplicationLagHigh
        # mongodb_replset_replication_lag is reported in seconds by the exporter.
        expr: mongodb_replset_replication_lag > 60
        for: 5m
        labels:
          severity: warning
        annotations:
          summary: "MongoDB replication lag above 60s"
          description: "Writes are not reaching secondary members quickly enough."

  - name: kidora.watchdog
    rules:
      # Always firing. Its only job is to give the Prometheus UI a series to
      # graph, so an entirely blank Prometheus is obviously broken rather than
      # ambiguously idle.
      - alert: Watchdog
        expr: vector(1)
        labels:
          severity: none
