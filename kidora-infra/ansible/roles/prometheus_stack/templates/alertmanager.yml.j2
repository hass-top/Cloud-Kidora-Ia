# =============================================================================
#  alertmanager.yml — generated by Ansible, DO NOT EDIT BY HAND
# =============================================================================
route:
  # Group by the `instance` label so one noisy server does not page for the
  # other two, then fall through to the catch-all receiver.
  group_by: ["alertname", "instance"]
  group_wait: 30s
  group_interval: 5m
  # Repeat for 6h: an unresolvable "node down" should keep trying for a
  # maintenance window, not alert once and go quiet.
  repeat_interval: 6h
  receiver: kidora-default
  routes:
    - matchers:
        - severity="critical"
      receiver: kidora-default
      repeat_interval: 1h

receivers:
  - name: kidora-default
{% if alertmanager_webhook_url | default('') | length > 0 %}
    webhook_configs:
      - url: "{{ alertmanager_webhook_url }}"
        send_resolved: true
{% else %}
    # No webhook configured. Alertmanager still records the alerts and they
    # are visible in the Grafana "Alerting" section; they are simply not
    # delivered anywhere. Set alertmanager_webhook_url in
    # inventories/staging/group_vars/monitoring.yml to turn delivery on.
{% endif %}

inhibit_rules:
  # A dead node already explains every "target down" for that node.
  - source_matchers: [alertname="Watchdog"]
    target_matchers: [alertname=~"TargetDown|InstanceDown"]
    equal: ["instance"]
