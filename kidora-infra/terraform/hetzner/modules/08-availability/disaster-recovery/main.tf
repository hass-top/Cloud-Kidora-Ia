# This module creates nothing. It verifies that the snapshots you intend to recover
# from still exist, and turns that into a concrete rebuild plan plus a runbook.
#
# That verification is real work rather than documentation: hcloud_snapshot exposes
# only server_id, description and labels, so a snapshot ID that no longer resolves
# would otherwise only be discovered mid-incident. hcloud_image can look a snapshot
# up by ID, which is what makes the check possible.
data "hcloud_image" "snapshot" {
  for_each = var.recovery_points

  id = each.value.snapshot_id
}

locals {
  recovery_points = {
    for k, v in data.hcloud_image.snapshot : k => {
      snapshot_id = v.id
      type        = v.type
      created     = v.created
      deprecated  = v.deprecated
      description = v.description
      restorable  = v.type == "snapshot" || v.type == "backup"
    }
  }

  # A snapshot that is already deprecated is a recovery point with an expiry date,
  # which is worth surfacing before it becomes an outage.
  at_risk = {
    for k, v in local.recovery_points : k => v.deprecated
    if v.deprecated != null
  }

  runbook = join("\n", concat(
    ["# Disaster recovery runbook", ""],
    "Generated by the 08-availability/disaster-recovery Terraform module.", "",
    "## Verified recovery points", "",
    concat([for k, v in local.recovery_points : "- `${k}` (image ${v.snapshot_id}, type ${v.type}, created ${v.created})"]),
    "",
    "## Rebuild a server from a snapshot", "",
    "1. Confirm the snapshot still resolves: it is listed above and was read during `terraform plan`.",
    "2. Create a replacement server with `image` set to the snapshot ID from 06-storage/snapshot.",
    "3. Attach the same volumes with 06-storage/volume-attachment; volume data is never in the snapshot.",
    "4. Re-apply 03-network/server-network so the private address matches what the application expects.",
    "5. Move DNS with 10-dns/dns, then verify the health check in 07-load-balancing/load-balancer-target reports healthy.",
    "",
    "## Known gaps", "",
    "- Rescue mode is not manageable through Terraform: the provider has no rescue resource.",
    "- Server groups are not manageable through Terraform: the provider has no such resource.",
    "- Volume backup windows are not declaratively manageable in provider 1.69.",
    "- Custom images cannot be created by Terraform; only snapshots and system images are addressable.",
  ))
}