#cloud-config
# Generated by the 04-security/ssh-hardening Terraform module.
# This is a cloud-init fragment: it runs on every boot, never prompts, and is
# safe to re-apply. It hardens the host before any password-based access is
# possible, and complements rather than replaces the Ansible ssh_hardening role
# that runs later in the provisioning chain.

package_update: true
package_upgrade: false

packages:
%{ for p in packages ~}
  - ${p}
%{ endfor ~}

write_files:
  - path: /etc/ssh/sshd_config.d/10-hardening.conf
    owner: root
    group: root
    permissions: "0644"
    content: |
      # Managed by Terraform: 04-security/ssh-hardening
      PasswordAuthentication ${password_authentication ? "yes" : "no"}
      KbdInteractiveAuthentication ${password_authentication ? "yes" : "no"}
      PermitEmptyPasswords no
      PermitRootLogin ${permit_root_login}
      X11Forwarding no
      MaxAuthTries ${max_auth_tries}
      LoginGraceTime ${login_grace_time}
      ClientAliveInterval ${client_alive_interval}
      ClientAliveCountMax ${client_alive_count_max}
      AllowTcpForwarding ${allow_tcp_forwarding ? "yes" : "no"}
      AllowAgentForwarding no
%{ if length(ssh_ciphers) > 0 ~}
      Ciphers ${ssh_ciphers}
%{ endif ~}
%{ if length(extra_sshd_directives) > 0 ~}
${indent(6, extra_sshd_directives)}
%{ endif ~}
  - path: /etc/fail2ban/jail.d/sshd.local
    owner: root
    group: root
    permissions: "0644"
    content: |
      [sshd]
      enabled  = ${fail2ban_enabled ? "true" : "false"}
      backend  = systemd
      bantime  = ${fail2ban_bantime}
      findtime = ${fail2ban_findtime}
      maxretry = ${fail2ban_maxretry}
      ignoreip = ${join(" ", fail2ban_ignoreip)}

runcmd:
  - [ sh, -c, "sshd -t || echo 'sshd config rejected, keeping the previous one' " ]
  - [ systemctl, restart, "${service_name}" ]
  - [ systemctl, enable, "--now", "fail2ban" ]