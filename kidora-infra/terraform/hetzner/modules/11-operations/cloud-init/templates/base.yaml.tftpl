#cloud-config
# Generated by the 11-operations/cloud-init Terraform module.
# Base node configuration. Runs on every boot, never prompts, and is idempotent.
# Secret-bearing files (for example a monitoring scrape config with tokens) are
# deliberately NOT written here: pass them through write_files with mode 0600 from
# the environment layer, or let Ansible place them from the vault.

timezone: ${timezone}
hostname: ${hostname}
manage_etc_hosts: ${manage_etc_hosts ? "true" : "false"}

package_update: true
package_upgrade: false

packages:
%{ for p in packages ~}
  - ${p}
%{ endfor ~}

users:
  - name: ${user_name}
    gecos: Managed by Terraform
    shell: /bin/bash
    sudo: ALL=(ALL) NOPASSWD:ALL
    lock_passwd: true
    ssh_authorized_keys:
%{ for k in ssh_authorized_keys ~}
      - ${k}
%{ endfor ~}

write_files:
  - path: /etc/environment
    owner: root
    group: root
    permissions: "0644"
    content: |
      TF_ENVIRONMENT=${environment}
      TF_PROJECT=${project}
%{ if length(node_exporter) > 0 ~}
      NODE_EXPORTER_ENABLED=${node_exporter}
%{ endif ~}

runcmd:
  - [ systemctl, enable, --now, "chrony" ]
  - [ sh, -c, "timedatectl set-timezone ${timezone}" ]